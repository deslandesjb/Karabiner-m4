{
  "title": "Base Hyperkey",
  "rules": [
    {
      "description": "✱✱ Hyperkey ✱✱ - General",
      "manipulators": [
        {
          "description": "capslock = esc(click) | hyper(hold)",
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "right_shift",
              "modifiers": ["right_command", "right_control", "right_option"]
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 400
          }
        }
      ]
    },
    {
      "description": "Hyperkey ✱ - Command",
      "manipulators": [
        {
          "description": "hyper cmd d -> hyper z (lu w)",
          "type": "basic",
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": [
                "left_command",
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "w",
              "modifiers": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          ]
        }
      ]
    },

    {
      "description": "Hyperkey ✱ - Classic",
      "manipulators": [
        {
          "description": "hyper non_us_backslash -> q",
          "type": "basic",
          "from": {
            "key_code": "non_us_backslash",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "q",
              "modifiers": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          ]
        },
        {
          "description": "hyper delete_forward -> g",
          "type": "basic",
          "from": {
            "key_code": "delete_forward",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "g",
              "modifiers": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Hyperkey ✱ - Apps",
      "manipulators": [
        {
          "description": "hyper A (physique) -> Arc",
          "type": "basic",
          "from": {
            "key_code": "q",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -b company.thebrowser.Browser"
            }
          ]
        },
        {
          "description": "hyper Q (physique) -> f16 (pour que hyper q fonctionne)",
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "f16",
              "modifiers": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          ]
        },
        {
          "description": "hyper Z -> Zed",
          "type": "basic",
          "from": {
            "key_code": "w",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -b dev.zed.Zed"
            }
          ]
        },
        {
          "description": "hyper W -> WhatsApp",
          "type": "basic",
          "from": {
            "key_code": "z",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -b net.whatsapp.WhatsApp"
            }
          ]
        },
        {
          "description": "hyper X -> Spark",
          "type": "basic",
          "from": {
            "key_code": "x",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -b com.readdle.smartemail-Mac"
            }
          ]
        },
        {
          "description": "hyper + cmd_gauche + Z -> cmux",
          "type": "basic",
          "from": {
            "key_code": "w",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option",
                "left_command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -b com.cmuxterm.app"
            }
          ]
        }
      ]
    }
  ]
}
