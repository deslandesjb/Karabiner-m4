{
  "title": "Base Hyperkey",
  "rules": [
    {
      "description": "✱✱ Hyperkey ✱✱ - General",
      "manipulators": [
        {
          "description": "capslock = esc(click) | hyper(hold)",
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "right_shift",
              "modifiers": ["right_command", "right_control", "right_option"]
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 400
          }
        }
      ]
    },
    {
      "description": "Hyperkey ✱ - Command",
      "manipulators": [
        {
          "description": "hyper cmd d -> hyper z (lu w)",
          "type": "basic",
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": [
                "left_command",
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "w",
              "modifiers": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          ]
        }
      ]
    },

    {
      "description": "Hyperkey ✱ - Classic",
      "manipulators": [
        {
          "description": "hyper non_us_backslash -> q",
          "type": "basic",
          "from": {
            "key_code": "non_us_backslash",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "q",
              "modifiers": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          ]
        },
        {
          "description": "hyper delete_forward -> g",
          "type": "basic",
          "from": {
            "key_code": "delete_forward",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "g",
              "modifiers": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Hyperkey ✱ - Opt",
      "manipulators": [
        {
          "description": "hyper opt a -> rctrl ropt rcmd a",
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option",
                "left_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "a",
              "modifiers": ["right_control", "right_option", "right_command"]
            }
          ]
        },
        {
          "description": "hyper opt z -> rctrl ropt rcmd z",
          "type": "basic",
          "from": {
            "key_code": "z",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option",
                "left_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "z",
              "modifiers": ["right_control", "right_option", "right_command"]
            }
          ]
        },
        {
          "description": "hyper opt 1 -> rctrl ropt rcmd 1",
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option",
                "left_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "1",
              "modifiers": ["right_control", "right_option", "right_command"]
            }
          ]
        },
        {
          "description": "hyper opt 2 -> rctrl ropt rcmd 2",
          "type": "basic",
          "from": {
            "key_code": "2",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option",
                "left_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "2",
              "modifiers": ["right_control", "right_option", "right_command"]
            }
          ]
        },
        {
          "description": "hyper opt 3 -> rctrl ropt rcmd 3",
          "type": "basic",
          "from": {
            "key_code": "3",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option",
                "left_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "3",
              "modifiers": ["right_control", "right_option", "right_command"]
            }
          ]
        },
        {
          "description": "hyper opt 4 -> rctrl ropt rcmd 4",
          "type": "basic",
          "from": {
            "key_code": "4",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option",
                "left_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "4",
              "modifiers": ["right_control", "right_option", "right_command"]
            }
          ]
        }
      ]
    },
    {
      "description": "Hyperkey ✱ - Apps",
      "manipulators": [
        {
          "description": "hyper & (physique) -> Zen",
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -b app.zen-browser.zen"
            }
          ]
        },
        {
          "description": "hyper Q (physique) -> f16 (pour que hyper q fonctionne)",
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "f16",
              "modifiers": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          ]
        },
        {
          "description": "hyper Z -> Zed",
          "type": "basic",
          "from": {
            "key_code": "w",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "[ -n \"$(/usr/bin/lsappinfo info -app dev.zed.Zed)\" ] && /usr/bin/open -b dev.zed.Zed"
            }
          ]
        },
        {
          "description": "hyper W -> WhatsApp",
          "type": "basic",
          "from": {
            "key_code": "z",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -b net.whatsapp.WhatsApp"
            }
          ]
        },
        {
          "description": "hyper X -> Spark",
          "type": "basic",
          "from": {
            "key_code": "x",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -b com.readdle.smartemail-Mac"
            }
          ]
        },
        {
          "description": "hyper C -> Slack",
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "[ -n \"$(/usr/bin/lsappinfo info -app com.tinyspeck.slackmacgap)\" ] && /usr/bin/open -b com.tinyspeck.slackmacgap"
            }
          ]
        },
        {
          "description": "hyper A -> orca",
          "type": "basic",
          "from": {
            "key_code": "q",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "[ -n \"$(/usr/bin/lsappinfo info -app com.stablyai.orca)\" ] && /usr/bin/open -b com.stablyai.orca"
            }
          ]
        },
        {
          "description": "hyper A -> cmux",
          "type": "basic",
          "from": {
            "key_code": "q",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option",

                "left_command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "[ -n \"$(/usr/bin/lsappinfo info -app com.cmuxterm.app)\" ] && /usr/bin/open -b com.cmuxterm.app"
            }
          ]
        },
        {
          "description": "hyper E -> ctrl tab",
          "type": "basic",
          "from": {
            "key_code": "e",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_shift",
                "right_option"
              ],
              "optional": ["right_control"]
            }
          },
          "to": [{ "key_code": "tab" }]
        }
      ]
    },
    {
      "description": "Hyperkey ✱ - Mouse",
      "manipulators": [
        {
          "description": "hyper up -> wheel up",
          "type": "basic",
          "from": {
            "key_code": "up_arrow",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [{ "mouse_key": { "vertical_wheel": -64 } }]
        },
        {
          "description": "hyper down -> wheel down",
          "type": "basic",
          "from": {
            "key_code": "down_arrow",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [{ "mouse_key": { "vertical_wheel": 64 } }]
        },
        {
          "description": "hyper left -> wheel left",
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [{ "mouse_key": { "horizontal_wheel": 64 } }]
        },
        {
          "description": "hyper right -> wheel right",
          "type": "basic",
          "from": {
            "key_code": "right_arrow",
            "modifiers": {
              "mandatory": [
                "right_command",
                "right_control",
                "right_shift",
                "right_option"
              ]
            }
          },
          "to": [{ "mouse_key": { "horizontal_wheel": -64 } }]
        }
      ]
    }
  ]
}
